# === データベース（Module 3・7で設定） ===
# Neon または Supabase の接続文字列をここに設定する
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# === 認証（Module 3で設定） ===
# GitHub OAuth App の Client ID / Client Secret
GITHUB_ID=""
GITHUB_SECRET=""

# NextAuth用のシークレット（`openssl rand -base64 32` 等で生成）
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
