# ============================================================
# 環境変数の設定ファイル
# このファイルを .env という名前でコピーして使います。
# .env は Git にコミットされません（.gitignore 済み）。
# ============================================================

# === データベース（第3章で設定） ===
# Neon または Supabase で作成したデータベースの接続文字列を貼り付ける
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"


# === 認証：GitHub OAuth（第1章で設定） ===
# 認証機能そのものは実装済みです。
# GitHub で OAuth App を作成し、以下の3つを設定すればログインできるようになります。
# 手順は「受講者用演習手順書」の第1章 STEP8 を参照してください。

# GitHub OAuth App の Client ID
GITHUB_ID=""

# GitHub OAuth App の Client Secret
GITHUB_SECRET=""

# セッション暗号化用のランダムな文字列
# 次のコマンドで生成できます（OS共通）:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# アプリのURL。ローカル開発中はこのままでOK。
# 第5章で Vercel にデプロイする際は、公開URLに変更します。
NEXTAUTH_URL="http://localhost:3000"
