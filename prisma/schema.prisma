// このファイルはスターターです。
//
// User モデルは【実装済みの認証機能】が使用するため、すでに用意してあります。
// 変更する場合は、src/lib/auth.ts の処理と整合が取れているか確認してください。
// （githubId は認証処理がユーザーを特定するために使っています）
//
// Project / Task / Comment、および担当者アサインのためのリレーションは、
// 第3章（設計と実装）で docs/requirements.md をもとに Claude Code と
// 一緒に設計し、ここに追加してください。
//
// 設計の際に検討してほしい観点（docs/requirements.md も参照）：
//   - タスクのステータスをどう表現するか（enumか、文字列か）
//   - タグをどう持たせるか（多対多の中間テーブルが必要か）
//   - 担当者アサインは1人だけか、複数人を許容するか

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  githubId  String   @unique
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO(第3章): Project / Task とのリレーションをここに追加する
  // 例: ownedProjects Project[]
  // 例: assignedTasks Task[]
}

